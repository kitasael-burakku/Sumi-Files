config/kitty/colors/colors.conf
config/hyprlock/colors.conf
config/hyprlock/scripts/music-colors.sh
config/hypr/dynamic-colors.sh
config/hypr/colors.lua
config/fish/conf.d/theme-goldship.fish
config/gtk-3.0/gtk-colors.css
config/gtk-4.0/gtk-colors.css
config/qt5ct/colors/minimaru.conf
config/qt6ct/colors/minimaru.conf
/config/starship.toml
config/kitty/sumi-shell-fonts.conf

# ── Local state and private files (see .dotbackup-exclude) ────────────────
config/fastfetch/.fastfetch_bag
config/fastfetch/fastfetchlogo/*.png
config/fastfetch/fastfetchlogo/fox.txt
config/fish/fish_variables
config/fish/conf.d/local.fish
config/hypr/modules/private.lua
config/hypr/.current-wallpaper
config/hypr/.current-wallpaper-outputs
config/hyprlock/wallpapers/
config/matugen/enabled
config/matugen/scheme
config/matugen/mode
config/matugen/contrast
config/matugen/source
# Completions are local except the two that complete published functions.
config/fish/completions/*
!config/fish/completions/ec.fish
!config/fish/completions/minimaru.fish

# ── Never commit ────────────────────────────────────────────────────────────
*.key
*.pem
*.p12
*.token
.env
.env.*
*credentials*
*secret*

# ── Media (wallpapers are not distributed) ─────────────────────────────────
*.mp4
*.mkv
*.webm
*.mov

# ── Caches, backups, editors ───────────────────────────────────────────────
__pycache__/
*.pyc
*.log
*.tmp
*.swp
*~
*.bak
*.bak-*
*.old
*.orig
.vscode/
!config/hypr/.vscode/
!config/hypr/.vscode/settings.json
.idea/
.DS_Store

# ── Agent notes ────────────────────────────────────────────────────────────
CLAUDE.md
.claude/
