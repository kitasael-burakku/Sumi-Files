// Duki · Modo Diablo · Fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": "   ",
    "color": { "keys": "red" }
  },
  "logo": { "type": "none" },
  "modules": [
    {
      "type": "custom",
      "format": "{#31}██████╗ ██╗   ██╗██╗  ██╗██╗\n{#31}██╔══██╗██║   ██║██║ ██╔╝██║\n{#91}██║  ██║██║   ██║█████╔╝ ██║\n{#91}██║  ██║██║   ██║██╔═██╗ ██║\n{#31}██████╔╝╚██████╔╝██║  ██╗██║\n{#31}╚═════╝  ╚═════╝ ╚═╝  ╚═╝╚═╝\n{#90}          • 𝘔𝘰𝘥𝘰 𝘋𝘪𝘢𝘣𝘭𝘰 • 𖤐 𖤐"
    },
    "break",
    {
      "type": "command",
      "key":  "{#31} User",
      "text": "test -n \"$USER_PRETTY\" && printf '%s' \"$USER_PRETTY\" || printf '%s' \"$USER\"",
      "format": "{result}"
    },
    {
      "type": "command",
      "key":  "{#31}󰌢 Host",
      "text": "hostnamectl --pretty 2>/dev/null || hostname",
      "format": "{result}"
    },
    "break",
    {
      "type": "os",
      "key":    "{#33} OS",
      "format": "{pretty-name}  {#90}[{arch}]"
    },
    {
      "type": "kernel",
      "key":    "{#33}├ Kernel",
      "format": "{sysname}  {#90}[v{release}]"
    },
    {
      "type": "shell",
      "key":    "{#33}└ Shell",
      "format": "{pretty-name}  {#90}[v{version}]"
    },
    "break",
    {
      "type": "cpu",
      "key":    "{#34}󰻠 CPU",
      "temp": true,
      "format": "{name}  {temperature}  {#90}[{freq-max}]"
    },
    {
      "type": "gpu",
      "key":    "{#34}├󰍛 GPU",
      "detectionMethod": "auto",
      "driverSpecific": false,
      "format": "{name}"
    },
    {
      "type": "memory",
      "key":    "{#34}├󰑭 Memory",
      "format": "{used} / {total}  {#90}({percentage}{#90})"
    },
    {
      "type": "uptime",
      "key":    "{#34}└󰅐 Uptime",
      "format": "{?days}{days}d {?}{hours}h {minutes}m"
    },
    "break"
  ]
}
