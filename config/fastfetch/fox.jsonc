// Fox · Kitsune · Fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "~/.config/fastfetch/fastfetchlogo/fox.txt",
    "type": "file",
    // Degradado con la paleta de la terminal (sigue a matugen):
    // rojo → verde → magenta → blanco, según tu tema
    "color": {
      "1": "31",
      "2": "31",
      "3": "32",
      "4": "32",
      "5": "32",
      "6": "35",
      "7": "95",
      "8": "37",
      "9": "97"
    },
    "padding": { "top": 2, "left": 2, "right": 4 }
  },

  "display": {
    "separator": " ~> "
  },

  "modules": [
    {
      "type": "custom",
      "format": "{#31}きつね  {#90}· clever little fox ·"
    },

    {
      "type": "command",
      "key":  "{#31} Fox",
      "text": "test -n \"$USER_PRETTY\" && printf '%s' \"$USER_PRETTY\" || printf '%s' \"$USER\"",
      "format": "{result}"
    },

    {
      "type": "command",
      "key":  "{#31}󰌢 Den",
      "text": "hostnamectl --pretty 2>/dev/null || hostname",
      "format": "{result}"
    },

    "break",

    {
      "type": "os",
      "key":    "{#33} OS",
      "format": "{pretty-name}  {#90}[{arch}]"
    },

    {
      "type": "kernel",
      "key":    "{#33}├ Kernel",
      "format": "{sysname}  {#90}[v{release}]"
    },

    {
      "type": "packages",
      "key":    "{#33}├󰏖 Packages",
      "format": "{all}"
    },

    {
      "type": "shell",
      "key":    "{#33}└ Shell",
      "format": "{pretty-name}  {#90}[v{version}]"
    },

    "break",

    {
      "type": "wm",
      "key":    "{#34}󱂬 WM",
      "format": "{pretty-name}"
    },

    {
      "type": "terminal",
      "key":    "{#34}├ Terminal",
      "format": "{pretty-name}  {#90}[{version}]"
    },

    {
      "type": "terminalfont",
      "key":    "{#34}├ Font",
      "format": "{name}  {#90}[{size}]"
    },

    // fastfetch no detecta awww, así que se lo preguntamos directamente
    {
      "type": "command",
      "key":  "{#34}└󰸉 Wallpaper",
      "text": "awww query 2>/dev/null | sed -n 's|.*image: ||p' | head -n1 | xargs -r basename",
      "format": "{result}"
    },

    "break",

    {
      "type": "host",
      "key":    "{#32}󰌢 Body"
    },

    {
      "type": "cpu",
      "key":    "{#32}├󰻠 Cunning",
      "temp": true,
      "format": "{name}  {temperature}  {#90}[{freq-max}]"
    },

    {
      "type": "gpu",
      "key":    "{#32}├󰍛 Sharp eyes",
      "temp": true,
      "detectionMethod": "auto",
      "driverSpecific": false,
      "format": "{name}  {temperature}"
    },

    {
      "type": "memory",
      "key":    "{#32}├󰑭 Stash",
      "format": "{used} / {total}  {#90}({percentage}{#90})"
    },

    {
      "type": "disk",
      "key":    "{#32}├ Burrow",
      "folders": "/",
      "format": "{size-used} / {size-total}  {#90}({size-percentage}{#90})"
    },

    {
      "type": "uptime",
      "key":    "{#32}└󰅐 Prowling",
      "format": "{?days}{days}d {?}{hours}h {minutes}m"
    },

    "break",

    {
      "type": "colors",
      "symbol": "circle"
    },

    "break"
  ]
}
