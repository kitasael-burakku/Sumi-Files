{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "~/.config/fastfetch/fastfetchlogo/Yani.png",
    "type": "kitty-direct",
    "width": 45,
    "height": 18,
    "padding": {
      "top":3
    }
  },

  "display": {
    "separator": " ~> "
  },

  "modules": [
    
    {
      "type": "custom",
      "format": "ヤニねこ",

      "key": "{#35}Chainsmoker cat"
    },
    
    {
      "type": "command",
      "key":  "{#35}󰌢 User",
      "text": "test -n \"$USER_PRETTY\" && printf '%s' \"$USER_PRETTY\" || printf '%s' \"$USER\"",
      "format": "{result}"
    },
    
    "break",
    
    {
      "type": "os",
      "key":    "{#33} OS",
      "format": "{pretty-name} {#90}[{arch}]"
    },
    
    {
      "type": "kernel",
      "key":    "{#33}├╮ (. ❛ ᴗ ❛.) Kernel",
      "format": "{sysname} {#90}[v{release}]"
    },
    
    {
      "type": "packages",
      "key":    "{#33}├󰏖 Packages",
      "format": "{all}"
    },
    
    {
      "type": "shell",
      "key":    "{#33}├>_ Shell",
      "format": "{pretty-name} {#90}[v{version}]"
    },

    {
      "type": "custom",
      "format":"└➤ Does anyone care about this? Nya~ (. ❛ ᴗ ❛.)",
      "outputColor": "33"
    },
    
    "break",
    
    {
      "type": "wm",
      "key":    "{#34}󱂬 WM",
      "format": "{pretty-name}"
    },
    
    {
      "type": "terminal",
      "key":    "{#34}├_⿻🗖 Terminal",
      "format": "{pretty-name}  {#90}[{version}]"
    },
    
    {
      "type": "terminalfont",
      "key":    "{#34}├🗒 Font",
      "format": "{name}  {#90}[{size}]"
    },
    
    {
        "type": "sound",
        "key": "{#34}├ SND"
    },
    {
        "type": "player",
        "key": "{#34}├{icon} Player"
    },

    {
      "type": "custom",
      "format":"└➤ Is that a cigarette? ( ≖‿  ≖ )",
      "outputColor": "34"
    },
    
    "break",
    
    {
      "type": "host",
      "key":    "{#32}󰌢 Cigarettes ᝰ🚬 ( ≖‿  ≖ )"
    },
    
    {
      "type": "cpu",
      "key":    "{#32}├󰻠 CPU",
      "temp": true,
      "format": "{name}  {temperature}  {#90}[{freq-max}]"
    },
    
    {
      "type": "gpu",
      "key":    "{#32}├󰍛 GPU",
      "detectionMethod": "auto",
      "driverSpecific": false,
      "format": "{name}"
    },
    
    {
      "type": "memory",
      "key":    "{#32}├󰑭 Memory",
      "format": "{used} / {total}  {#90}({percentage}{#90})"
    },

    {
      "type": "disk",
      "folders": "/",
      "key":    "{#32}├🖴 Disk",
      "format": "{size-used} / {size-total}  {#90}({size-percentage}{#90})"
    },

    {
      "type": "custom",
      "format":"├➤ idk what is this? Nya~ (. ❛ ᴗ ❛.)",
      "outputColor": "32"
    },

    {
      "type": "uptime",
      "key":    "{#32}└󰅐 Should I smoke now? ᝰ🚬 ( ≖‿  ≖ )",
      "format": "{?days}{days}d {?}{hours}h {minutes}m"
    },
    
    "break",
    
    {
      "type": "colors",
      "symbol": "circle"
    },

    "break"
  ]
}